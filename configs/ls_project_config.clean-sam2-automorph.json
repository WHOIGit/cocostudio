{
  "host": "https://ichthyolith.whoi.edu",
  "general": {
    "title": "Clean Fullframe ROI's from SAM2-Automorph",
    "description": "Used to review fullframe-rois",
    "task_sampling": "sequential",
    "color": "#FF0000"
  },
  "label_config": "config/fullframe-cycle.xml",
  "storage": [{
    "type": "cloud-source",
    "title": "ichthyolith storage",
    "bucket": "ichthyolith",
    "endpoint_url": "http://vast.whoi.edu",
    "presigned_urls": true,
    "presigned_urls_expiry": 15,
    "bucket_prefix": "fullframe_halfsize",
    "import_method": "tasks",
    "file_name_filter": "(?!)",
    "scan_all_subfolders": true
  }],
  "ml_backend": {
    "name":"SAM2 BigImg",
    "backend_url": "https://mlbackend.brick.whoi.edu/SAM2BigImg/",
    "interactive": true,
    "extra_params": {"crop_size":1024}
  },
  "annotations": {
    "instructions": "These are dummy instructions",
    "show_before_labeling": true,
    "prelabeling":{
      "enable": true,
      "model_name": "SAM2 BigImg"
    }
  }
}
